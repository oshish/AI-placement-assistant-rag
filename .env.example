# ==============================================================================
# Your AI Placement Assistant (UCS503P) - Environment Configuration
# ==============================================================================

# Google Gemini API Key for Grounded Answer Generation
# Obtain your key from: https://aistudio.google.com/app/apikey
# If left blank, the application operates in 100% Offline RAG Mode,
# returning exact retrieved question evidence without LLM synthesis.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Default: gemini-2.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
